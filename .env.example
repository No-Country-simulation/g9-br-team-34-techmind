# TechMind - variables de entorno de la ORQUESTACION (docker compose).
#
#   cp .env.example .env
#
# Docker Compose lee el archivo .env de esta carpeta automaticamente. Este
# archivo es distinto de backend/.env.example: aquel configura el backend cuando
# se ejecuta suelto con Maven; este configura los contenedores.
#
# .env NUNCA se sube al repositorio (ya esta en .gitignore). Solo se versiona
# este ejemplo, sin valores reales.

# ===========================================================================
# DESARROLLO LOCAL  (suficiente para: docker compose up --build)
# ===========================================================================

BACKEND_PORT=8080
ML_SERVICE_PORT=8000

SPRING_PROFILES_ACTIVE=dev
INFERENCE_SERVICE_TIMEOUT_MS=5000

DB_USERNAME=sa
DB_PASSWORD=

# Clave que el backend exigira en las peticiones una vez que el equipo
# implemente AuthenticationFilter. Vacia en local.
TECHMIND_API_KEY=

CORS_ALLOWED_ORIGINS=http://localhost:3000

# Maximo de palabras clave que devuelve el modelo en `informacion_adicional`.
MAX_KEYWORDS=5
ML_LOG_LEVEL=info


# ===========================================================================
# PRODUCCION EN OCI  (solo se completan en el .env de la VM, nunca aqui)
# ===========================================================================
#
# Estas variables las consume docker-compose.prod.yml. En la VM se rellenan una
# sola vez, a mano; en GitHub Actions viajan como secrets del repositorio.
#
# Como obtener cada valor: docs/devops/despliegue-oci.md

# Registro de contenedores de OCI. El prefijo depende de la region:
#   Sao Paulo  -> gru.ocir.io
#   Ashburn    -> iad.ocir.io
#   Santiago   -> scl.ocir.io
#   Bogota     -> bog.ocir.io
# OCIR_REGISTRY=gru.ocir.io

# Namespace del tenancy. Se obtiene con: oci os ns get
# OCI_NAMESPACE=

# OCI_REGION=sa-saopaulo-1
# OCI_BUCKET_NAME=techmind-models
# OCI_MODEL_OBJECT=model.joblib

# Etiqueta de las imagenes a desplegar. La canalizacion de CD usa el SHA del
# commit en vez de `latest`, para que siempre se sepa exactamente que codigo
# esta corriendo y para que un rollback sea cambiar una variable.
# IMAGE_TAG=latest
