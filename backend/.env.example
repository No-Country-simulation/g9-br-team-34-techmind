# Servidor
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Servicio de inferencia (Ciencia de Datos)
INFERENCE_SERVICE_URL=http://localhost:8000
INFERENCE_SERVICE_TIMEOUT_MS=5000

# Base de datos (H2 embebida)
DB_USERNAME=sa
DB_PASSWORD=
DB_FILE_PATH=/app/data/techmind

# OCI Object Storage
OCI_NAMESPACE=
OCI_BUCKET_NAME=techmind-models
OCI_REGION=
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# Seguridad
TECHMIND_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000