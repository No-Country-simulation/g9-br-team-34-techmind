# Servidor
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev

# Servicio de inferencia (Ciencia de Datos)
#https://logitree-model.onrender.com
INFERENCE_SERVICE_URL=https://modelo-test.onrender.com
INFERENCE_SERVICE_TIMEOUT_MS=15000

# Base de datos (H2 embebida)
DB_USERNAME=sa
DB_PASSWORD=
DB_FILE_PATH=/app/data/techmind

# OCI Object Storage
# Metodo de autenticacion contra OCI. Definir uno solo:
#   config_file        -> usa OCI_CONFIG_FILE + OCI_CONFIG_PROFILE
#   env_vars           -> usa OCI_USER_OCID, OCI_TENANCY_OCID, OCI_FINGERPRINT, y UNA de: OCI_PRIVATE_KEY_CONTENT (Base64) u OCI_PRIVATE_KEY_PATH (archivo)
#   instance_principal -> no requiere credenciales, solo si la app corre dentro de OCI Compute
OCI_AUTH_METHOD=config_file
OCI_NAMESPACE=
OCI_BUCKET_NAME=techmind-models
OCI_REGION=
OCI_CONFIG_FILE=~/.oci/config
OCI_CONFIG_PROFILE=DEFAULT

# OCI - requeridas solo si OCI_AUTH_METHOD=env_vars
OCI_USER_OCID=
OCI_TENANCY_OCID=
OCI_FINGERPRINT=
# Usa UNA de las dos siguientes (Content tiene prioridad si ambas están definidas):
OCI_PRIVATE_KEY_CONTENT=
OCI_PRIVATE_KEY_PATH=
OCI_PRIVATE_KEY_PASSPHRASE=

#Gemini
GEMINI_API_KEY=

# Seguridad
TECHMIND_API_KEY=
CORS_ALLOWED_ORIGINS=http://localhost:3000